table SLA

	column Prioridad
		dataType: string
		summarizeBy: none
		sourceColumn: Prioridad
		sortByColumn: OrdenPrioridad

	column HorasSLA
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: HorasSLA

	column OrdenPrioridad
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: OrdenPrioridad

	partition SLA = m
		mode: import
		source =
				let
					Origen = Csv.Document(File.Contents(RutaDatos & "SLA.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
					Tildes = Table.TransformColumns(Encabezados, {{"Prioridad", fnTildes, type text}}),
					Tipos = Table.TransformColumnTypes(Tildes, {{"HorasSLA", Int64.Type}, {"OrdenPrioridad", Int64.Type}}, "en-US")
				in
					Tipos
