{
  "name": "ITAM Portfolio",
  "dataColors": ["#2563EB", "#0EA5A4", "#F59E0B", "#EF4444", "#8B5CF6", "#64748B", "#22C55E", "#EC4899"],
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "maximum": "#1E3A8A",
  "center": "#93C5FD",
  "minimum": "#EFF6FF",
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0F172A" },
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0F172A" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#334155" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#475569" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F1F5F9" } }, "transparency": 0 }]
      }
    }
  }
}
